# ============================================
# EVNuvora Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================

# --- Server ---
NODE_ENV=development
PORT=3000
API_VERSION=v1

# --- Database (Neon PostgreSQL) ---
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://username:password@host/EVNuvora?sslmode=require

# --- Authentication ---
# Generate strong random strings for these!
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Razorpay (Payment Gateway) ---
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- File Storage ---
# For development, files are stored locally in ./uploads
# For production, configure S3-compatible storage
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
# S3_BUCKET=EVNuvora-uploads
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=your-s3-access-key
# S3_SECRET_KEY=your-s3-secret-key

# --- Push Notifications ---
# Expo Push Notifications (free)
# No key needed for Expo push — uses project ID

# --- CORS ---
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
