# ============================================
# ChargeKaro Mobile App Environment
# ============================================

# Backend API base URL (use your local machine IP for real device testing, e.g., http://192.168.1.100:3000/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Maps API Key for Mobile Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_mobile_api_key

# Razorpay Key ID (Client-safe public key)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
