{
  "name": "chargekaro",
  "version": "0.1.0",
  "private": true,
  "description": "ChargeKaro - India's EV Charging Marketplace",
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "mobile": "npm run dev --workspace=apps/mobile",
    "server": "npm run dev --workspace=server",
    "admin": "npm run dev --workspace=apps/admin",
    "dev": "concurrently \"npm:server\" \"npm:mobile\"",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "build:server": "npm run build --workspace=server",
    "build:admin": "npm run build --workspace=apps/admin",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:reset": "npm run db:reset --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "~5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
